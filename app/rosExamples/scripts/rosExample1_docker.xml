<application>
<name>ros EXAMPLE1</name>

<dependencies>
</dependencies>

<module>
   <name>yarpdev</name>
   <parameters>--device transformServer --ROS "(enable_ros_publisher 1)" "(enable_ros_subscriber 1)"</parameters>
   <node>console</node>
</module>

<module>
   <name>yarpdev</name>
   <parameters>--device fakeMotionControl --name /robot_2wheels/mobile_base --GENERAL::Joints 2</parameters>
   <node>console</node>
</module>

<module>
   <name>baseControl</name>
   <parameters>--context baseControl_SIM --from robot_2wheels.ini --skip_robot_interface_check</parameters>
   <node>console</node>
</module>

<module>
   <name>yarpdev</name>
   <parameters>--device map2DServer --mapCollectionContext mapsExample</parameters>
   <node>console</node>
</module>

<module>
   <name>roslaunch</name>
   <parameters>amcl_map_from_ros.launch</parameters>
   <workdir>/home/user1/navigation/app/rosExamples/launch/</workdir>
   <node>console</node>
</module>

<module>
   <name>yarpdev</name>
   <parameters>--device localization2DServer --subdevice rosLocalizer --context rosExamples --from localizationServer_ros.ini</parameters>
   <node>console</node>
</module>

<module>
   <name>yarpdev</name>
   <parameters>--device Rangefinder2DWrapper --subdevice fakeLaser --period 10 --name /robot_2wheels/laser:o --test use_mapfile --map_context mapsExample --map_file map_test.map --localization_client --ROS::useROS true --ROS::ROS_nodeName /finder --ROS::ROS_topicName /laser --ROS::frame_id mobile_base_body_link</parameters>
   <node>console</node>
</module>

<module>
   <name>yarpdev</name>
   <parameters>--device navigation2DServer --subdevice robotPathPlannerDev --context robotPathPlannerExamples --from robotPathPlanner_robot_2wheels.ini</parameters>
   <node>console</node>
</module>

<module>
   <name>navigationGUI</name>
   <parameters>--context navigationGUI --from navigationGUI_robot_2wheels.ini</parameters>
   <node>console</node>
</module>

<module>
   <name>yarpview</name>
   <parameters>--name /plannerView:i --out /mapClick:o</parameters>
   <node>console</node>
</module>

<connection>
  <from>/robotGoto/control:o</from>
  <to>/baseControl/control:i</to>
  <protocol>udp</protocol>
</connection>

<connection>
  <from>/navigationGui/map:o</from>
  <to>/plannerView:i</to>
  <protocol>udp</protocol>
</connection>

<connection>
  <from>/robotPathPlanner/commands:o</from>
  <to>/robotGoto/rpc</to>
  <protocol>tcp</protocol>
</connection>

<connection>
  <from>/robotGoto/status:o</from>
  <to>/robotPathPlanner/navigationStatus:i</to>
  <protocol>tcp</protocol>
</connection>

<connection>
  <from>/mapClick:o</from>
  <to>/navigationGui/yarpviewTarget:i</to>
  <protocol>tcp</protocol>
</connection>

<connection>
  <from>/navigationGui/yarpviewTarget:o</from>
  <to>/robotPathPlanner/rpc</to>
  <protocol>tcp</protocol>
</connection>

<connection>
  <from>/baseControl/odometry:o</from>
  <to>/fakeLaser/location:i</to>
  <protocol>tcp</protocol>
</connection>

</application>
